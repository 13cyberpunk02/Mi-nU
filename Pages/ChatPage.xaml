<?xml version="1.0" encoding="utf-8" ?>
<!-- A chat on its own screen, as on a phone; a wide window shows the same ChatView next to the list instead. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Mi_nU.Controls"
             x:Class="Mi_nU.Pages.ChatPage"
             BackgroundColor="{DynamicResource ChatBackground}"
             Shell.NavBarIsVisible="False"
             SafeAreaEdges="All">

    <controls:ChatView x:Name="View" ShowBack="True" />

</ContentPage>
