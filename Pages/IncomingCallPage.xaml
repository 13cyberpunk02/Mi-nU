<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Mi_nU.Pages.IncomingCallPage"
             Shell.NavBarIsVisible="False">

    <VerticalStackLayout Padding="24" Spacing="16" MaximumWidthRequest="420" VerticalOptions="Center">
        <Label x:Name="CallerLabel" AutomationId="IncomingCaller" Style="{StaticResource SubHeadline}" />
        <Label x:Name="KindLabel" AutomationId="IncomingKind" HorizontalTextAlignment="Center" />
        <Label x:Name="ErrorLabel" AutomationId="IncomingError" IsVisible="False" HorizontalTextAlignment="Center"
               TextColor="{AppThemeBinding Light=#B3261E, Dark=#F2B8B5}" />
        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
            <Button x:Name="DeclineButton" AutomationId="IncomingDecline" Text="Отклонить" BackgroundColor="#B3261E" TextColor="White" Clicked="OnDeclineClicked" />
            <Button Grid.Column="1" x:Name="AcceptButton" AutomationId="IncomingAccept" Text="Ответить" BackgroundColor="#1B7F3B" TextColor="White" Clicked="OnAcceptClicked" />
        </Grid>
    </VerticalStackLayout>

</ContentPage>
