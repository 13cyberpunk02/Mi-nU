<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pages="clr-namespace:Mi_nU.Pages"
             x:Class="Mi_nU.Pages.NewGroupPage"
             Title="Новая группа">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Padding="16,12" RowSpacing="8">
        <Entry x:Name="TitleEntry" AutomationId="NewGroupTitle" Placeholder="Название группы" />
        <Label Grid.Row="1" x:Name="MembersLabel" AutomationId="NewGroupMembers" Text="Участники не выбраны" />
        <Entry Grid.Row="2" x:Name="SearchEntry" AutomationId="NewGroupSearch" Placeholder="Добавить: логин или имя, минимум 2 символа"
               IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" TextChanged="OnSearchChanged" />
        <Label Grid.Row="3" x:Name="ErrorLabel" AutomationId="NewGroupError" IsVisible="False"
               TextColor="{AppThemeBinding Light=#B3261E, Dark=#F2B8B5}" />
        <CollectionView Grid.Row="4" x:Name="Results" AutomationId="NewGroupResults" SelectionMode="Single" SelectionChanged="OnUserSelected">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="pages:GroupUserRow">
                    <VerticalStackLayout Padding="8,10">
                        <Label Text="{Binding Name}" FontAttributes="Bold" />
                        <Label Text="{Binding UserName}" FontSize="12"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Button Grid.Row="5" x:Name="CreateButton" AutomationId="NewGroupCreate" Text="Создать группу" Clicked="OnCreateClicked" />
    </Grid>

</ContentPage>
