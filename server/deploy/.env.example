# Copy to .env next to docker-compose.yml and fill in. Never commit .env: it holds the secrets.

# The domain the app connects to, with an A record pointing at this server.
API_DOMAIN=api.example.com

# The domain files are downloaded from, with an A record pointing at this server too.
FILES_DOMAIN=files.example.com

# Generate each with: openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_KEY=
# The server's keys for file storage. Letters and digits only, as they go into a JSON file.
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# The TURN server from Maui.WebRTC's docs/turn.md, and the static-auth-secret from its turnserver.conf.
TURN_HOST=turn.example.com
TURN_SECRET=
