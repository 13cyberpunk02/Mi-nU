# Copy to .env next to docker-compose.yml and fill in. Never commit .env: it holds the secrets.

# The domain the app connects to, with an A record pointing at this server.
API_DOMAIN=api.example.com

# Generate each with: openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_KEY=

# The TURN server from Maui.WebRTC's docs/turn.md, and the static-auth-secret from its turnserver.conf.
TURN_HOST=turn.example.com
TURN_SECRET=
