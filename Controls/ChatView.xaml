<?xml version="1.0" encoding="utf-8" ?>
<!-- One conversation: a page of its own on a phone, the right-hand pane in a wide window. -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Mi_nU.Controls"
             xmlns:themes="clr-namespace:Mi_nU.Themes"
             x:Class="Mi_nU.Controls.ChatView"
             BackgroundColor="{DynamicResource ChatBackground}">

    <ContentView.Resources>
        <!--
            The day sits in the middle of the whole row; only the bubble keeps clear of the other side.
            Photos fill their bubble to the edges, the caption and time in a strip below (see MessageRow.IsMedia).
        -->
        <DataTemplate x:Key="MineTemplate" x:DataType="controls:MessageRow">
            <VerticalStackLayout Padding="12,0" Margin="{Binding Spacing}">
                <Border Style="{StaticResource DayPill}" IsVisible="{Binding ShowDay}">
                    <Label Text="{Binding Day}" Style="{StaticResource Small}" />
                </Border>
                <Border HorizontalOptions="End" Margin="52,0,0,0" Padding="{Binding BubblePadding}" StrokeThickness="0" StrokeShape="RoundRectangle 18,18,18,6"
                        BackgroundColor="{DynamicResource BubbleMine}" MaximumWidthRequest="520" WidthRequest="{Binding MediaWidth}">
                    <VerticalStackLayout Spacing="2">
                        <VerticalStackLayout Spacing="{Binding AttachmentSpacing}" IsVisible="{Binding HasAttachments}" BindableLayout.ItemsSource="{Binding Shown}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="controls:AttachmentItem">
                                    <controls:AttachmentView Item="{Binding .}" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="2" Padding="{Binding FooterPadding}">
                        <Label Text="{Binding Text}" LineHeight="1.25" IsVisible="{Binding HasText}" />
                        <HorizontalStackLayout HorizontalOptions="End" Spacing="4">
                            <Label Text="{Binding Status}" Style="{StaticResource Small}" TextColor="{DynamicResource BubbleMineMuted}" VerticalTextAlignment="Center" />
                            <Label Text="{Binding Receipt}" IsVisible="{Binding ShowReceipt}" FontFamily="Icons" FontSize="14"
                                   TextColor="{DynamicResource BubbleMineMuted}" VerticalTextAlignment="Center"
                                   SemanticProperties.Description="{Binding ReceiptDescription}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding Read}" Value="True">
                                        <Setter Property="TextColor" Value="{DynamicResource AccentText}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </DataTemplate>
        <DataTemplate x:Key="MineFailedTemplate" x:DataType="controls:MessageRow">
            <VerticalStackLayout Padding="12,0" Margin="{Binding Spacing}">
                <Border Style="{StaticResource DayPill}" IsVisible="{Binding ShowDay}">
                    <Label Text="{Binding Day}" Style="{StaticResource Small}" />
                </Border>
                <Border HorizontalOptions="End" Margin="52,0,0,0" Padding="{Binding BubblePadding}" StrokeThickness="0" StrokeShape="RoundRectangle 18,18,18,6"
                        BackgroundColor="{DynamicResource BubbleFailed}" MaximumWidthRequest="520" WidthRequest="{Binding MediaWidth}">
                    <VerticalStackLayout Spacing="2">
                        <VerticalStackLayout Spacing="{Binding AttachmentSpacing}" IsVisible="{Binding HasAttachments}" BindableLayout.ItemsSource="{Binding Shown}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="controls:AttachmentItem">
                                    <controls:AttachmentView Item="{Binding .}" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="2" Padding="{Binding FooterPadding}">
                            <Label Text="{Binding Text}" LineHeight="1.25" IsVisible="{Binding HasText}" />
                            <Label Text="{Binding Status}" Style="{StaticResource Small}" TextColor="{DynamicResource DangerText}" HorizontalOptions="End" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </DataTemplate>
        <DataTemplate x:Key="OtherTemplate" x:DataType="controls:MessageRow">
            <VerticalStackLayout Padding="12,0" Margin="{Binding Spacing}">
                <Border Style="{StaticResource DayPill}" IsVisible="{Binding ShowDay}">
                    <Label Text="{Binding Day}" Style="{StaticResource Small}" />
                </Border>
                <Border HorizontalOptions="Start" Margin="0,0,52,0" Padding="{Binding BubblePadding}" StrokeThickness="0" StrokeShape="RoundRectangle 18,18,6,18"
                        BackgroundColor="{DynamicResource BubbleOther}" MaximumWidthRequest="520" WidthRequest="{Binding MediaWidth}">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding Sender}" IsVisible="{Binding ShowSenderName}" Margin="{Binding NamePadding}"
                               FontFamily="InterSemiBold" FontSize="13" TextColor="{DynamicResource AccentText}" />
                        <VerticalStackLayout Spacing="{Binding AttachmentSpacing}" IsVisible="{Binding HasAttachments}" BindableLayout.ItemsSource="{Binding Shown}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="controls:AttachmentItem">
                                    <controls:AttachmentView Item="{Binding .}" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="2" Padding="{Binding FooterPadding}">
                            <Label Text="{Binding Text}" LineHeight="1.25" IsVisible="{Binding HasText}" />
                            <Label Text="{Binding Status}" Style="{StaticResource Small}" HorizontalOptions="End" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </DataTemplate>
        <!-- A call: the icon in a circle, what happened, and when; a tap calls back. -->
        <DataTemplate x:Key="MineCallTemplate" x:DataType="controls:MessageRow">
            <VerticalStackLayout Padding="12,0" Margin="{Binding Spacing}">
                <Border Style="{StaticResource DayPill}" IsVisible="{Binding ShowDay}">
                    <Label Text="{Binding Day}" Style="{StaticResource Small}" />
                </Border>
                <Border HorizontalOptions="End" Margin="52,0,0,0" Padding="10,8,14,8" StrokeThickness="0" StrokeShape="RoundRectangle 18,18,18,6"
                        BackgroundColor="{DynamicResource BubbleMine}" SemanticProperties.Description="{Binding CallDescription}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Border WidthRequest="36" HeightRequest="36" StrokeThickness="0" StrokeShape="RoundRectangle 18"
                                BackgroundColor="{DynamicResource Surface}" VerticalOptions="Center">
                            <Label Text="{Binding CallIcon}" FontFamily="Icons" FontSize="18" TextColor="{DynamicResource AccentText}"
                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                            <Label Text="{Binding CallTitle}" FontFamily="InterSemiBold" FontSize="15" />
                            <Label Text="{Binding CallDetails}" Style="{StaticResource Small}" TextColor="{DynamicResource BubbleMineMuted}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </DataTemplate>
        <DataTemplate x:Key="OtherCallTemplate" x:DataType="controls:MessageRow">
            <VerticalStackLayout Padding="12,0" Margin="{Binding Spacing}">
                <Border Style="{StaticResource DayPill}" IsVisible="{Binding ShowDay}">
                    <Label Text="{Binding Day}" Style="{StaticResource Small}" />
                </Border>
                <Border HorizontalOptions="Start" Margin="0,0,52,0" Padding="10,8,14,8" StrokeThickness="0" StrokeShape="RoundRectangle 18,18,6,18"
                        BackgroundColor="{DynamicResource BubbleOther}" SemanticProperties.Description="{Binding CallDescription}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Border WidthRequest="36" HeightRequest="36" StrokeThickness="0" StrokeShape="RoundRectangle 18"
                                BackgroundColor="{DynamicResource AccentSoft}" VerticalOptions="Center">
                            <Label Text="{Binding CallIcon}" FontFamily="Icons" FontSize="18" TextColor="{DynamicResource AccentText}"
                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding CallMissed}" Value="True">
                                        <Setter Property="TextColor" Value="{DynamicResource DangerText}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                            <Label Text="{Binding Sender}" IsVisible="{Binding ShowSenderName}" FontFamily="InterSemiBold" FontSize="13" TextColor="{DynamicResource AccentText}" />
                            <Label Text="{Binding CallTitle}" FontFamily="InterSemiBold" FontSize="15">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding CallMissed}" Value="True">
                                        <Setter Property="TextColor" Value="{DynamicResource DangerText}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Label Text="{Binding CallDetails}" Style="{StaticResource Small}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </DataTemplate>
        <!-- A round video message: the circle itself, no bubble, with the time (and ticks) under it. -->
        <DataTemplate x:Key="MineNoteTemplate" x:DataType="controls:MessageRow">
            <VerticalStackLayout Padding="12,0" Margin="{Binding Spacing}">
                <Border Style="{StaticResource DayPill}" IsVisible="{Binding ShowDay}">
                    <Label Text="{Binding Day}" Style="{StaticResource Small}" />
                </Border>
                <VerticalStackLayout HorizontalOptions="End" Margin="52,0,0,0" Spacing="2">
                    <controls:AttachmentView Item="{Binding FirstAttachment}" />
                    <HorizontalStackLayout HorizontalOptions="End" Spacing="4" Margin="0,0,8,0">
                        <Label Text="{Binding Status}" Style="{StaticResource Small}" VerticalTextAlignment="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsFailed}" Value="True">
                                    <Setter Property="TextColor" Value="{DynamicResource DangerText}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <Label Text="{Binding Receipt}" IsVisible="{Binding ShowReceipt}" FontFamily="Icons" FontSize="14"
                               TextColor="{DynamicResource TextMuted}" VerticalTextAlignment="Center"
                               SemanticProperties.Description="{Binding ReceiptDescription}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding Read}" Value="True">
                                    <Setter Property="TextColor" Value="{DynamicResource AccentText}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </DataTemplate>
        <DataTemplate x:Key="OtherNoteTemplate" x:DataType="controls:MessageRow">
            <VerticalStackLayout Padding="12,0" Margin="{Binding Spacing}">
                <Border Style="{StaticResource DayPill}" IsVisible="{Binding ShowDay}">
                    <Label Text="{Binding Day}" Style="{StaticResource Small}" />
                </Border>
                <VerticalStackLayout HorizontalOptions="Start" Margin="0,0,52,0" Spacing="2">
                    <Label Text="{Binding Sender}" IsVisible="{Binding ShowSenderName}" Margin="8,0"
                           FontFamily="InterSemiBold" FontSize="13" TextColor="{DynamicResource AccentText}" />
                    <controls:AttachmentView Item="{Binding FirstAttachment}" />
                    <Label Text="{Binding Status}" Style="{StaticResource Small}" Margin="8,0" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </DataTemplate>
        <!-- A change to the group: a quiet line in the middle, like the day above messages. -->
        <DataTemplate x:Key="SystemTemplate" x:DataType="controls:MessageRow">
            <VerticalStackLayout Padding="24,0" Margin="{Binding Spacing}" Spacing="8">
                <Border Style="{StaticResource DayPill}" IsVisible="{Binding ShowDay}">
                    <Label Text="{Binding Day}" Style="{StaticResource Small}" />
                </Border>
                <!-- A long line wraps, so a softer corner than the day's pill. -->
                <Border Style="{StaticResource DayPill}" Margin="0" StrokeShape="RoundRectangle 12" MaximumWidthRequest="420">
                    <Label Text="{Binding Text}" Style="{StaticResource Small}" HorizontalTextAlignment="Center" />
                </Border>
            </VerticalStackLayout>
        </DataTemplate>
        <controls:MessageTemplateSelector x:Key="MessageSelector"
                                          System="{StaticResource SystemTemplate}"
                                          Mine="{StaticResource MineTemplate}"
                                          MineFailed="{StaticResource MineFailedTemplate}"
                                          Other="{StaticResource OtherTemplate}"
                                          MineCall="{StaticResource MineCallTemplate}"
                                          OtherCall="{StaticResource OtherCallTemplate}"
                                          MineNote="{StaticResource MineNoteTemplate}"
                                          OtherNote="{StaticResource OtherNoteTemplate}" />
    </ContentView.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
        <Grid BackgroundColor="{DynamicResource Surface}" Padding="8,8,12,8" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
            <Button x:Name="BackButton" AutomationId="ChatBack" Text="{x:Static themes:Icons.Back}" Style="{StaticResource IconButton}"
                    FontSize="26" SemanticProperties.Description="Назад к чатам" Clicked="OnBackClicked" />
            <!-- For a group, the avatar and name open the group's page, as the members button does. -->
            <controls:Avatar Grid.Column="1" x:Name="HeaderAvatar" Size="40" VerticalOptions="Center" Margin="4,0,0,0">
                <controls:Avatar.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnHeaderTapped" />
                </controls:Avatar.GestureRecognizers>
            </controls:Avatar>
            <VerticalStackLayout Grid.Column="2" VerticalOptions="Center">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnHeaderTapped" />
                </VerticalStackLayout.GestureRecognizers>
                <Label x:Name="HeaderName" AutomationId="ChatTitle" Style="{StaticResource Name}" />
                <Label x:Name="HeaderSubtitle" Style="{StaticResource Small}" IsVisible="False" />
            </VerticalStackLayout>
            <Button Grid.Column="3" AutomationId="ChatCallAudio" Text="{x:Static themes:Icons.Phone}" Style="{StaticResource IconButton}"
                    SemanticProperties.Description="Позвонить" Clicked="OnAudioCallClicked" />
            <Button Grid.Column="4" AutomationId="ChatCallVideo" Text="{x:Static themes:Icons.Video}" Style="{StaticResource IconButton}"
                    SemanticProperties.Description="Видеозвонок" Clicked="OnVideoCallClicked" />
            <Button Grid.Column="5" x:Name="GroupInfoButton" AutomationId="ChatGroupInfo" Text="{x:Static themes:Icons.Users}" Style="{StaticResource IconButton}"
                    SemanticProperties.Description="Участники и настройки группы" Clicked="OnHeaderTapped" IsVisible="False" />
        </Grid>
        <BoxView Grid.Row="1" Style="{StaticResource Divider}" />

        <Grid Grid.Row="2" RowDefinitions="Auto,*">
            <Button x:Name="OlderButton" AutomationId="ChatOlder" Text="Показать предыдущие" Style="{StaticResource GhostButton}"
                    IsVisible="False" HorizontalOptions="Center" Clicked="OnOlderClicked" />
            <CollectionView Grid.Row="1" x:Name="Messages" AutomationId="ChatMessages" SelectionMode="Single"
                            ItemTemplate="{StaticResource MessageSelector}" SelectionChanged="OnMessageSelected"
                            MaximumWidthRequest="{StaticResource ReadableWidth}">
                <CollectionView.Footer>
                    <BoxView HeightRequest="12" Color="Transparent" />
                </CollectionView.Footer>
            </CollectionView>
        </Grid>

        <Label Grid.Row="3" x:Name="ErrorLabel" AutomationId="ChatError" IsVisible="False" Margin="16,4" Style="{StaticResource Error}" />

        <Grid Grid.Row="4" BackgroundColor="{DynamicResource Surface}" Padding="12,8">
            <Grid x:Name="Composer" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" MaximumWidthRequest="{StaticResource ReadableWidth}">
                <!-- Photos: the text typed meanwhile goes along as their caption. -->
                <Button x:Name="AttachButton" AutomationId="ChatAttach" Text="{x:Static themes:Icons.Paperclip}" Style="{StaticResource IconButton}"
                        SemanticProperties.Description="Прикрепить фото или файл" VerticalOptions="End" Clicked="OnAttachClicked" />
                <Border Grid.Column="1" Style="{StaticResource FilledField}" StrokeShape="RoundRectangle 22">
                    <Entry x:Name="MessageEntry" AutomationId="ChatInput" Placeholder="Сообщение" Keyboard="Chat" ReturnType="Send"
                           Completed="OnSendClicked" TextChanged="OnMessageTextChanged" />
                </Border>
                <!-- With nothing typed: a round video message, or in the send button's place, a voice message. -->
                <Button Grid.Column="2" x:Name="VideoNoteButton" AutomationId="ChatVideoNote" Text="{x:Static themes:Icons.Camera}"
                        Style="{StaticResource IconButton}" VerticalOptions="End"
                        SemanticProperties.Description="Записать видеосообщение" Clicked="OnVideoNoteClicked" />
                <Grid Grid.Column="3" VerticalOptions="End">
                    <Button x:Name="SendButton" AutomationId="ChatSend" Text="{x:Static themes:Icons.Send}" Style="{StaticResource FilledIconButton}"
                            SemanticProperties.Description="Отправить" IsVisible="False" Clicked="OnSendClicked" />
                    <Button x:Name="RecordButton" AutomationId="ChatRecord" Text="{x:Static themes:Icons.Mic}" Style="{StaticResource FilledIconButton}"
                            SemanticProperties.Description="Записать голосовое сообщение" Clicked="OnRecordClicked" />
                </Grid>
            </Grid>

            <Grid x:Name="RecordingBar" IsVisible="False" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" MaximumWidthRequest="{StaticResource ReadableWidth}">
                <Button AutomationId="ChatRecordCancel" Text="{x:Static themes:Icons.Trash}" Style="{StaticResource IconButton}"
                        TextColor="{DynamicResource DangerText}" SemanticProperties.Description="Отменить запись" Clicked="OnRecordCancelClicked" />
                <!-- The voice as it is being recorded: the bars grow from the left as the microphone hears it. -->
                <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10" VerticalOptions="Center" Padding="8,0">
                    <BoxView WidthRequest="10" HeightRequest="10" CornerRadius="5" Color="{DynamicResource DangerText}" VerticalOptions="Center" />
                    <Label Grid.Column="1" x:Name="RecordingTime" AutomationId="ChatRecordTime" Text="0:00" Style="{StaticResource Name}" VerticalOptions="Center" />
                    <controls:WaveformView Grid.Column="2" x:Name="LiveWave" VerticalOptions="Center" Progress="1"
                                           PlayedColor="{DynamicResource DangerText}" RestColor="{DynamicResource TextMuted}" />
                </Grid>
                <Button Grid.Column="2" AutomationId="ChatRecordSend" Text="{x:Static themes:Icons.Send}" Style="{StaticResource FilledIconButton}"
                        SemanticProperties.Description="Отправить голосовое сообщение" Clicked="OnRecordSendClicked" />
            </Grid>
        </Grid>

        <!--
            Recording a round video message: over the whole chat, the camera in a circle (mirrored, as a mirror shows
            one's face), a ring filling towards the one-minute limit, the time, and cancel or send.
        -->
        <Grid Grid.RowSpan="5" x:Name="VideoNoteOverlay" IsVisible="False" BackgroundColor="#E60E1114">
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="20">
                <Grid WidthRequest="276" HeightRequest="276" HorizontalOptions="Center">
                    <Border WidthRequest="260" HeightRequest="260" StrokeThickness="0" StrokeShape="Ellipse" BackgroundColor="#262D33"
                            HorizontalOptions="Center" VerticalOptions="Center">
                        <controls:CameraPreview x:Name="NotePreview" ScaleX="-1" />
                    </Border>
                    <controls:RingProgress x:Name="NoteRing" Color="{StaticResource Danger}" Thickness="5" />
                </Grid>
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                    <BoxView WidthRequest="10" HeightRequest="10" CornerRadius="5" Color="{StaticResource Danger}" VerticalOptions="Center" />
                    <Label x:Name="NoteTime" AutomationId="VideoNoteRecordTime" Text="0:00" FontFamily="InterSemiBold" FontSize="17"
                           TextColor="{StaticResource CallText}" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="40">
                    <Button AutomationId="VideoNoteCancel" Text="{x:Static themes:Icons.Trash}" Style="{StaticResource CallButton}"
                            SemanticProperties.Description="Отменить видеосообщение" Clicked="OnVideoNoteCancelClicked" />
                    <Button AutomationId="VideoNoteSend" Text="{x:Static themes:Icons.Send}" Style="{StaticResource CallButton}"
                            BackgroundColor="{StaticResource CallAccent}"
                            SemanticProperties.Description="Отправить видеосообщение" Clicked="OnVideoNoteSendClicked" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Grid>
    </Grid>

</ContentView>
