<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Mi_nU"
             xmlns:controls="clr-namespace:Mi_nU.Controls"
             xmlns:themes="clr-namespace:Mi_nU.Themes"
             x:Class="Mi_nU.MainPage"
             Shell.NavBarIsVisible="False">

    <!-- A wide window shows the open chat beside the list; the code-behind switches the columns. -->
    <Grid x:Name="Root" ColumnDefinitions="*,0">
    <Grid x:Name="ListPane" RowDefinitions="Auto,Auto,*">
        <Grid ColumnDefinitions="*,Auto" Padding="16,16,16,4">
            <Label Text="Чаты" Style="{StaticResource Title}" VerticalTextAlignment="Center" />
            <Button Grid.Column="1" x:Name="ProfileButton" AutomationId="MainProfile" Text="Я" FontSize="15"
                    Style="{StaticResource IconButton}" FontFamily="InterSemiBold" WidthRequest="40" HeightRequest="40" CornerRadius="20"
                    BackgroundColor="{DynamicResource AccentSoft}" TextColor="{DynamicResource AccentInk}"
                    SemanticProperties.Description="Профиль и выход" Clicked="OnProfileClicked" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource FilledField}" Margin="16,8,16,8">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <Label Text="{x:Static themes:Icons.Search}" Style="{StaticResource Icon}" FontSize="20" />
                <Entry Grid.Column="1" x:Name="SearchEntry" AutomationId="MainSearch" Placeholder="Поиск" IsSpellCheckEnabled="False"
                       IsTextPredictionEnabled="False" TextChanged="OnSearchChanged" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <CollectionView x:Name="ChatList" AutomationId="MainChats" SelectionMode="Single" SelectionChanged="OnChatSelected" Margin="8,0">
                <CollectionView.EmptyView>
                    <ContentView>
                        <VerticalStackLayout Spacing="8" VerticalOptions="Center" Padding="32">
                            <Label x:Name="EmptyTitle" Text="Чатов пока нет" Style="{StaticResource Heading}" HorizontalTextAlignment="Center" />
                            <Label x:Name="EmptyHint" Text="Нажмите «+», чтобы найти собеседника или создать группу" Style="{StaticResource Caption}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </ContentView>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="local:ChatRow">
                        <Grid ColumnDefinitions="52,*" ColumnSpacing="12" Padding="8,10">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup Name="CommonStates">
                                    <VisualState Name="Normal" />
                                    <VisualState Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="{DynamicResource AccentSoft}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <controls:Avatar Name="{Binding Title}" Seed="{Binding Seed}" Size="52" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label Text="{Binding Title}" Style="{StaticResource Name}" />
                                    <Label Grid.Column="1" Text="{Binding Time}" Style="{StaticResource Small}" VerticalTextAlignment="Center" />
                                </Grid>
                                <Label Text="{Binding Preview}" Style="{StaticResource Caption}" FontSize="15" LineBreakMode="TailTruncation" MaxLines="1" />
                            </VerticalStackLayout>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label x:Name="ErrorLabel" AutomationId="MainError" IsVisible="False" VerticalOptions="Start" Margin="16,0" Style="{StaticResource Error}" />

            <Button x:Name="NewChatButton" AutomationId="MainNewChat" Text="{x:Static themes:Icons.Plus}" Style="{StaticResource Fab}"
                    SemanticProperties.Description="Новый чат или группа"
                    HorizontalOptions="End" VerticalOptions="End" Margin="20,24" Clicked="OnNewChatClicked" />
        </Grid>
    </Grid>

    <Grid Grid.Column="1" x:Name="DetailPane" IsVisible="False" ColumnDefinitions="1,*">
        <BoxView Color="{DynamicResource Line}" WidthRequest="1" />
        <Grid Grid.Column="1" BackgroundColor="{DynamicResource ChatBackground}">
            <VerticalStackLayout x:Name="NoChatHint" Spacing="8" VerticalOptions="Center" HorizontalOptions="Center">
                <Label Text="Выберите чат" Style="{StaticResource Heading}" HorizontalTextAlignment="Center" />
                <Label Text="или начните новый с помощью «+»" Style="{StaticResource Caption}" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
            <controls:ChatView x:Name="Detail" ShowBack="False" IsVisible="False" />
        </Grid>
    </Grid>
    </Grid>

</ContentPage>
