<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Mi_nU"
             x:Class="Mi_nU.MainPage"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,*" Padding="16,12" RowSpacing="12">
        <Grid ColumnDefinitions="*,Auto">
            <Label Text="Чаты" Style="{StaticResource SubHeadline}" HorizontalOptions="Start" VerticalOptions="Center" />
            <Button Grid.Column="1" AutomationId="MainLogout" Text="Выйти" Clicked="OnLogoutClicked" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="8">
            <Button AutomationId="MainNewChat" Text="Новый чат" Clicked="OnNewChatClicked" />
            <Button Grid.Column="1" AutomationId="MainNewGroup" Text="Новая группа" Clicked="OnNewGroupClicked" />
        </Grid>

        <Grid Grid.Row="2">
            <CollectionView x:Name="ChatList" AutomationId="MainChats" SelectionMode="Single" SelectionChanged="OnChatSelected">
                <CollectionView.EmptyView>
                    <ContentView>
                        <Label x:Name="EmptyLabel" Text="Чатов пока нет. Найдите собеседника через «Новый чат»."
                               HorizontalTextAlignment="Center" VerticalOptions="Center" Margin="16" />
                    </ContentView>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="local:ChatRow">
                        <VerticalStackLayout Padding="8,10" Spacing="2">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Label Text="{Binding Title}" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                <Label Grid.Column="1" Text="{Binding Time}" FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                            </Grid>
                            <Label Text="{Binding Preview}" LineBreakMode="TailTruncation" MaxLines="1"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <Label x:Name="ErrorLabel" AutomationId="MainError" IsVisible="False" VerticalOptions="Start"
                   TextColor="{AppThemeBinding Light=#B3261E, Dark=#F2B8B5}" />
        </Grid>
    </Grid>

</ContentPage>
