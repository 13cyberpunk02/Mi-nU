<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Mi_nU"
             xmlns:controls="clr-namespace:Mi_nU.Controls"
             xmlns:themes="clr-namespace:Mi_nU.Themes"
             x:Class="Mi_nU.MainPage"
             Shell.NavBarIsVisible="False">

    <!-- A wide window shows the open chat beside the list; the code-behind switches the columns. -->
    <Grid x:Name="Root" ColumnDefinitions="*,0">
    <Grid x:Name="ListPane" RowDefinitions="Auto,Auto,*">
        <Grid ColumnDefinitions="*,Auto" Padding="16,16,16,4">
            <Label Text="Чаты" Style="{StaticResource Title}" VerticalTextAlignment="Center" />
            <!-- The user's own avatar, with a transparent button over it that opens the profile. -->
            <Grid Grid.Column="1" WidthRequest="40" HeightRequest="40">
                <controls:Avatar x:Name="ProfileAvatar" Size="40" />
                <Button x:Name="ProfileButton" AutomationId="MainProfile" BackgroundColor="Transparent" BorderWidth="0" CornerRadius="20"
                        Padding="0" SemanticProperties.Description="Профиль" Clicked="OnProfileClicked" />
            </Grid>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource FilledField}" Margin="16,8,16,8">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <Label Text="{x:Static themes:Icons.Search}" Style="{StaticResource Icon}" FontSize="20" />
                <Entry Grid.Column="1" x:Name="SearchEntry" AutomationId="MainSearch" Placeholder="Поиск" IsSpellCheckEnabled="False"
                       IsTextPredictionEnabled="False" TextChanged="OnSearchChanged" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <CollectionView x:Name="ChatList" AutomationId="MainChats" SelectionMode="Single" SelectionChanged="OnChatSelected" Margin="8,0">
                <CollectionView.EmptyView>
                    <ContentView>
                        <VerticalStackLayout Spacing="8" VerticalOptions="Center" Padding="32">
                            <Label x:Name="EmptyTitle" Text="Чатов пока нет" Style="{StaticResource Heading}" HorizontalTextAlignment="Center" />
                            <Label x:Name="EmptyHint" Text="Нажмите «+», чтобы найти собеседника или создать группу" Style="{StaticResource Caption}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </ContentView>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="local:ChatRow">
                        <Grid ColumnDefinitions="52,*" ColumnSpacing="12" Padding="8,10">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup Name="CommonStates">
                                    <VisualState Name="Normal" />
                                    <VisualState Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="{DynamicResource AccentSoft}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Grid VerticalOptions="Center" WidthRequest="52" HeightRequest="52">
                                <controls:Avatar Name="{Binding Title}" Seed="{Binding Seed}" PictureId="{Binding PictureId}" Size="52" />
                                <!-- The ring in the page colour sets the dot off the avatar. -->
                                <Border IsVisible="{Binding Online}" WidthRequest="16" HeightRequest="16" StrokeShape="RoundRectangle 8" StrokeThickness="3"
                                        Stroke="{DynamicResource Background}" BackgroundColor="{DynamicResource Accent}"
                                        HorizontalOptions="End" VerticalOptions="End" AutomationId="ChatOnline" SemanticProperties.Description="В сети" />
                            </Grid>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                                    <Label Text="{Binding Title}" Style="{StaticResource Name}" Margin="0,0,4,0" />
                                    <Label Grid.Column="1" Text="{Binding Receipt}" IsVisible="{Binding ShowReceipt}" FontFamily="Icons" FontSize="15"
                                           TextColor="{DynamicResource TextMuted}" VerticalTextAlignment="Center">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding ReceiptRead}" Value="True">
                                                <Setter Property="TextColor" Value="{DynamicResource AccentText}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Label Grid.Column="2" Text="{Binding Time}" Style="{StaticResource Small}" VerticalTextAlignment="Center">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding HasUnread}" Value="True">
                                                <Setter Property="TextColor" Value="{DynamicResource AccentText}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label Text="{Binding Preview}" Style="{StaticResource Caption}" FontSize="15" LineBreakMode="TailTruncation" MaxLines="1" />
                                    <Border Grid.Column="1" Style="{StaticResource Badge}" IsVisible="{Binding HasUnread}" VerticalOptions="Center"
                                            AutomationId="ChatUnread" SemanticProperties.Description="{Binding UnreadDescription}">
                                        <Label Text="{Binding Unread}" FontFamily="InterSemiBold" FontSize="12" TextColor="{DynamicResource OnAccent}"
                                               VerticalTextAlignment="Center" HorizontalTextAlignment="Center" />
                                    </Border>
                                </Grid>
                            </VerticalStackLayout>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label x:Name="ErrorLabel" AutomationId="MainError" IsVisible="False" VerticalOptions="Start" Margin="16,0" Style="{StaticResource Error}" />

            <Button x:Name="NewChatButton" AutomationId="MainNewChat" Text="{x:Static themes:Icons.Plus}" Style="{StaticResource Fab}"
                    SemanticProperties.Description="Новый чат или группа"
                    HorizontalOptions="End" VerticalOptions="End" Margin="20,24" Clicked="OnNewChatClicked" />
        </Grid>
    </Grid>

    <Grid Grid.Column="1" x:Name="DetailPane" IsVisible="False" ColumnDefinitions="1,*">
        <BoxView Color="{DynamicResource Line}" WidthRequest="1" />
        <Grid Grid.Column="1" BackgroundColor="{DynamicResource ChatBackground}">
            <VerticalStackLayout x:Name="NoChatHint" Spacing="8" VerticalOptions="Center" HorizontalOptions="Center">
                <Label Text="Выберите чат" Style="{StaticResource Heading}" HorizontalTextAlignment="Center" />
                <Label Text="или начните новый с помощью «+»" Style="{StaticResource Caption}" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
            <controls:ChatView x:Name="Detail" ShowBack="False" IsVisible="False" />
        </Grid>
    </Grid>
    </Grid>

</ContentPage>
