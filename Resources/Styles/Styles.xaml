<?xml version="1.0" encoding="UTF-8" ?>
<!--
    The UI kit. Colors come from the active theme (Resources/Themes) through DynamicResource,
    so pages never name a color or size of their own: they pick a style from here.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Calls are dark in both themes: the video is the content. -->
    <Color x:Key="CallBackground">#101315</Color>
    <Color x:Key="CallSurface">#1A1E22</Color>
    <Color x:Key="CallControl">#2A3036</Color>
    <Color x:Key="CallTileColor">#262D33</Color>
    <Color x:Key="CallText">#ECEFF2</Color>
    <Color x:Key="CallMuted">#A3ACB6</Color>
    <Color x:Key="CallAccent">#4CC3B5</Color>
    <Color x:Key="Danger">#C6372E</Color>
    <Color x:Key="Success">#1F8A53</Color>
    <Color x:Key="OnStatus">#FFFFFF</Color>

    <x:Double x:Key="RadiusControl">12</x:Double>
    <x:Double x:Key="RadiusBubble">18</x:Double>
    <x:Double x:Key="ControlHeight">48</x:Double>
    <x:Double x:Key="IconSize">22</x:Double>
    <!-- Content stops growing past this on wide windows, so lines stay readable. -->
    <x:Double x:Key="ReadableWidth">760</x:Double>

    <!-- Pages -->
    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{DynamicResource Background}" />
        <Setter Property="Shell.BackgroundColor" Value="{DynamicResource Surface}" />
        <Setter Property="Shell.ForegroundColor" Value="{DynamicResource Text}" />
        <Setter Property="Shell.TitleColor" Value="{DynamicResource Text}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{DynamicResource Surface}" />
        <Setter Property="Shell.ForegroundColor" Value="{DynamicResource Text}" />
        <Setter Property="Shell.TitleColor" Value="{DynamicResource Text}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
    </Style>

    <!-- Text -->
    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{DynamicResource Text}" />
    </Style>
    <Style x:Key="Title" TargetType="Label">
        <Setter Property="FontFamily" Value="InterBold" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="TextColor" Value="{DynamicResource Text}" />
        <Setter Property="SemanticProperties.HeadingLevel" Value="Level1" />
    </Style>
    <Style x:Key="Heading" TargetType="Label">
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="TextColor" Value="{DynamicResource Text}" />
    </Style>
    <Style x:Key="Name" TargetType="Label">
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="TextColor" Value="{DynamicResource Text}" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
        <Setter Property="MaxLines" Value="1" />
    </Style>
    <Style x:Key="Caption" TargetType="Label">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{DynamicResource TextMuted}" />
    </Style>
    <Style x:Key="Small" TargetType="Label">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{DynamicResource TextMuted}" />
    </Style>
    <Style x:Key="FieldLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="InterMedium" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{DynamicResource Text}" />
    </Style>
    <Style x:Key="Error" TargetType="Label">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{DynamicResource DangerText}" />
    </Style>
    <Style x:Key="Link" TargetType="Label">
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{DynamicResource AccentText}" />
    </Style>
    <!-- A Lucide glyph used as a picture rather than a button. -->
    <Style x:Key="Icon" TargetType="Label">
        <Setter Property="FontFamily" Value="Icons" />
        <Setter Property="FontSize" Value="{StaticResource IconSize}" />
        <Setter Property="TextColor" Value="{DynamicResource TextMuted}" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <!-- Fields: an Entry has no border of its own, so it sits in a Field border. -->
    <Style TargetType="Entry">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{DynamicResource Text}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource TextMuted}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>
    <Style x:Key="Field" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource InputBackground}" />
        <Setter Property="Stroke" Value="{DynamicResource InputBorder}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource ControlHeight}" />
        <Setter Property="Padding" Value="12,0" />
    </Style>
    <!-- Search and the message box: filled, no outline. -->
    <Style x:Key="FilledField" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceMuted}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="Padding" Value="12,0" />
    </Style>

    <!-- Buttons. The implicit one is the primary action: one per screen. -->
    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{DynamicResource OnAccent}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource Accent}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource ControlHeight}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource Disabled}" />
                            <Setter Property="TextColor" Value="{DynamicResource DisabledText}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>
    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{DynamicResource Text}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceMuted}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource ControlHeight}" />
    </Style>
    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{DynamicResource AccentText}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>
    <!-- Icon-only buttons need SemanticProperties.Description for screen readers. -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="FontFamily" Value="Icons" />
        <Setter Property="FontSize" Value="{StaticResource IconSize}" />
        <Setter Property="TextColor" Value="{DynamicResource Text}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="WidthRequest" Value="44" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="MinimumWidthRequest" Value="44" />
    </Style>
    <Style x:Key="FilledIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="TextColor" Value="{DynamicResource OnAccent}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource Accent}" />
    </Style>
    <!-- The floating "new chat" button. -->
    <Style x:Key="Fab" TargetType="Button" BasedOn="{StaticResource FilledIconButton}">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="WidthRequest" Value="56" />
        <Setter Property="HeightRequest" Value="56" />
        <Setter Property="CornerRadius" Value="18" />
    </Style>

    <!-- Call controls -->
    <Style x:Key="CallButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="TextColor" Value="{StaticResource CallText}" />
        <Setter Property="BackgroundColor" Value="{StaticResource CallControl}" />
        <Setter Property="WidthRequest" Value="56" />
        <Setter Property="HeightRequest" Value="56" />
        <Setter Property="CornerRadius" Value="28" />
    </Style>
    <!-- A control that is switched off shows inverted, so its state reads at a glance. -->
    <Style x:Key="CallButtonOff" TargetType="Button" BasedOn="{StaticResource CallButton}">
        <Setter Property="TextColor" Value="{StaticResource CallBackground}" />
        <Setter Property="BackgroundColor" Value="{StaticResource CallText}" />
    </Style>
    <Style x:Key="HangUpButton" TargetType="Button" BasedOn="{StaticResource CallButton}">
        <Setter Property="TextColor" Value="{StaticResource OnStatus}" />
        <Setter Property="BackgroundColor" Value="{StaticResource Danger}" />
        <Setter Property="WidthRequest" Value="64" />
    </Style>
    <Style x:Key="AnswerButton" TargetType="Button" BasedOn="{StaticResource CallButton}">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="TextColor" Value="{StaticResource OnStatus}" />
        <Setter Property="BackgroundColor" Value="{StaticResource Success}" />
        <Setter Property="WidthRequest" Value="72" />
        <Setter Property="HeightRequest" Value="72" />
        <Setter Property="CornerRadius" Value="36" />
    </Style>
    <Style x:Key="DeclineButton" TargetType="Button" BasedOn="{StaticResource AnswerButton}">
        <Setter Property="BackgroundColor" Value="{StaticResource Danger}" />
    </Style>
    <Style x:Key="CallLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource CallMuted}" />
    </Style>
    <Style x:Key="CallTile" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource CallTileColor}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 18" />
    </Style>
    <!-- Marks whoever is talking. -->
    <Style x:Key="CallTileSpeaking" TargetType="Border" BasedOn="{StaticResource CallTile}">
        <Setter Property="Stroke" Value="{StaticResource CallAccent}" />
        <Setter Property="StrokeThickness" Value="3" />
    </Style>
    <Style x:Key="TileNameText" TargetType="Label">
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource CallText}" />
    </Style>
    <!-- A name over a video tile. -->
    <Style x:Key="TileName" TargetType="Border">
        <Setter Property="BackgroundColor" Value="#B3101315" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 8" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="HorizontalOptions" Value="Start" />
        <Setter Property="VerticalOptions" Value="End" />
        <Setter Property="Margin" Value="8" />
    </Style>

    <!-- Surfaces -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource Surface}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="Padding" Value="16" />
    </Style>
    <Style x:Key="DayPill" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource Pill}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 999" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="Margin" Value="0,8" />
    </Style>
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource Accent}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 11" />
        <Setter Property="MinimumWidthRequest" Value="22" />
        <Setter Property="HeightRequest" Value="22" />
        <Setter Property="Padding" Value="7,0" />
    </Style>
    <Style x:Key="Divider" TargetType="BoxView">
        <Setter Property="Color" Value="{DynamicResource Line}" />
        <Setter Property="HeightRequest" Value="1" />
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{DynamicResource Accent}" />
    </Style>
    <Style TargetType="CollectionView">
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>
    <Style TargetType="RefreshView">
        <Setter Property="RefreshColor" Value="{DynamicResource Accent}" />
    </Style>

</ResourceDictionary>
