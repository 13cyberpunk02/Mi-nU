<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net11.0-android</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net11.0-windows10.0.19041.0</TargetFrameworks>

		<!-- libwebrtc for Android is only available for arm64 -->
		<RuntimeIdentifier Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">android-arm64</RuntimeIdentifier>

		<!-- The backend has its own projects and must not be compiled into the app -->
		<DefaultItemExcludes>$(DefaultItemExcludes);server\**</DefaultItemExcludes>

		<OutputType>Exe</OutputType>
		<RootNamespace>Mi_nU</RootNamespace>
		<!-- The apostrophe in the project name breaks Android's Java-to-.NET type lookup at startup -->
		<AssemblyName>MinU</AssemblyName>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Enable XAML source generation for faster build times and improved performance.
		     This generates C# code from XAML at compile time instead of runtime inflation.
		     To disable, remove this line.
		     For individual files, you can override by setting Inflator metadata:
		       <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
		       <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- Display name -->
		<ApplicationTitle>Mi`nU</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.cyberpunk02.minu</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<!-- Release Android builds are signed with your own key; see "Сборка для выпуска" in README.ru.md.
	     The password comes from an environment variable, so it never lands in this file or in git. -->
	<PropertyGroup Condition="'$(Configuration)' == 'Release' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<AndroidPackageFormat>apk</AndroidPackageFormat>
		<AndroidKeyStore>true</AndroidKeyStore>
		<AndroidSigningKeyStore>$(MINU_KEYSTORE)</AndroidSigningKeyStore>
		<AndroidSigningKeyAlias>minu</AndroidSigningKeyAlias>
		<AndroidSigningStorePass>env:MINU_KEYSTORE_PASSWORD</AndroidSigningStorePass>
		<AndroidSigningKeyPass>env:MINU_KEYSTORE_PASSWORD</AndroidSigningKeyPass>
	</PropertyGroup>

	<!-- A released Windows build carries .NET and Windows App SDK in its folder: other computers have neither. -->
	<PropertyGroup Condition="'$(Configuration)' == 'Release' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<SelfContained>true</SelfContained>
		<WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
	</PropertyGroup>

	<!-- Only to try a release build against a local server without HTTPS. Never for a build you hand out. -->
	<PropertyGroup Condition="'$(MinuAllowCleartext)' == 'true'">
		<DefineConstants>$(DefineConstants);ALLOW_CLEARTEXT</DefineConstants>
	</PropertyGroup>

	<!-- The server address, read by ServerConfig. MSBuild also takes it from an environment variable of the same name. -->
	<ItemGroup>
		<AssemblyMetadata Include="MinuServerUrl" Value="$(MinuServerUrl)" />
	</ItemGroup>

	<Target Name="CheckReleaseSettings" BeforeTargets="BeforeBuild" Condition="'$(Configuration)' == 'Release'">
		<Error Condition="'$(MinuServerUrl)' == ''" Text="Release builds need the server address: set MinuServerUrl, e.g. -p:MinuServerUrl=https://api.example.com (see README.ru.md)." />
		<Error Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' And ('$(MINU_KEYSTORE)' == '' Or '$(MINU_KEYSTORE_PASSWORD)' == '')"
		       Text="Release Android builds are signed: set MINU_KEYSTORE to your keystore and MINU_KEYSTORE_PASSWORD to its password (see README.ru.md)." />
	</Target>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0F6E66" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0F6E66" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />

		<!-- The Windows head's App.xaml is WinUI markup, compiled as the WinUI ApplicationDefinition. MAUI 11 also takes it
		     as MAUI XAML, and Visual Studio's XAML service then reports its WinUI types as missing, on every target. -->
		<MauiXaml Remove="Platforms\Windows\App.xaml" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="server\MinU.Contracts\MinU.Contracts.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="13CyberPunk02.Maui.WebRTC" Version="0.1.0-preview.3" />
		<PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="11.0.0" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="11.0.10" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="11.0.0" />
	</ItemGroup>

	<!-- Push through Firebase Cloud Messaging. google-services.json comes from the Firebase console and stays out of git;
	     without it the app builds and runs, only without push. -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<PackageReference Include="Xamarin.Firebase.Messaging" Version="125.1.3" />
		<!-- Firebase brings androidx.fragment 1.9, which absorbed fragment-ktx; MAUI's older fragment-ktx would then
		     define its classes twice and fail the build. The matching 1.9 ktx package is empty. -->
		<PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.9.0" />
		<!-- Firebase also brings lifecycle 2.11; MAUI's 2.9 LiveData and Process would otherwise warn (NU1608) that they want 2.9. -->
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData" Version="2.11.0.1" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.Process" Version="2.11.0.1" />
		<!-- MinuNoPush=true leaves it out, for a build under another package name, which Firebase doesn't know. -->
		<GoogleServicesJson Include="Platforms\Android\google-services.json" Condition="Exists('Platforms\Android\google-services.json') And '$(MinuNoPush)' != 'true'" />
	</ItemGroup>

	<!-- Windows App SDK 2.5 bug (microsoft/WindowsAppSDK#6774): AppNotificationManager.Register() in an unpackaged app
	     needs Microsoft.WindowsAppRuntime.Insights.Resource.dll beside it, which ships only inside the runtime's MSIX.
	     Without it the app fails at startup. Referenced directly at the version MAUI brings, only to know its folder. -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
		<PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.5.1" GeneratePathProperty="true" />
	</ItemGroup>

	<Target Name="AddWindowsAppRuntimeInsightsResource" BeforeTargets="AssignTargetPaths"
	        Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
		<PropertyGroup>
			<_InsightsName>Microsoft.WindowsAppRuntime.Insights.Resource.dll</_InsightsName>
			<_InsightsMsix>$(PkgMicrosoft_WindowsAppSDK_Runtime)\tools\MSIX\win10-x64\Microsoft.WindowsAppRuntime.2.msix</_InsightsMsix>
			<_InsightsDir>$(IntermediateOutputPath)wasdk-insights\</_InsightsDir>
		</PropertyGroup>
		<Error Condition="!Exists('$(_InsightsMsix)')" Text="Windows App SDK runtime MSIX not found at $(_InsightsMsix); check the Microsoft.WindowsAppSDK.Runtime version." />
		<Unzip SourceFiles="$(_InsightsMsix)" DestinationFolder="$(_InsightsDir)" Include="$(_InsightsName)" Condition="!Exists('$(_InsightsDir)$(_InsightsName)')" />
		<ItemGroup>
			<None Include="$(_InsightsDir)$(_InsightsName)" Link="$(_InsightsName)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		</ItemGroup>
	</Target>

</Project>
